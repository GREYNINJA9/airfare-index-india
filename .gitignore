
gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Environment & Secrets
.env
.env.local

# Scraper / Data Artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sample/*
!data/sample/.gitkeep
!data/sample/synthetic_fares.json
data/*.db
data/*.sqlite

# Playwright / Browser Artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
