ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airfare_index
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airfare_index
AUTO_SEED=false
USE_MOCK_DATA=false
SAVE_RAW=false
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_ONCE=false
# Optional comma-separated overrides, for example: DEL-BLR
SCHEDULER_ROUTES=
# Optional comma-separated ISO departure dates; defaults to today in UTC
SCHEDULER_DEPARTURE_DATES=
